{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/vsr.py\" pre",
            "timeout": 15,
            "statusMessage": "vSR guard: is this command safe to run?"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/vsr.py\" post",
            "timeout": 30,
            "statusMessage": "vSR redact and shield: reading the output"
          }
        ]
      }
    ]
  }
}
