{
  "description": "Shared token-count parsing contract for routing.signals.context min_tokens/max_tokens. The Router (config.TokenCount.Value, Go strconv.ParseFloat) is the reference; the CLI (cli/context_bands.parse_token_count) must accept and reject exactly these inputs. Both test suites load this file, so a change on one side fails the other.",
  "cases": [
    {"input": "", "value": 0, "note": "omitted counts parse as 0"},
    {"input": "   ", "value": 0, "note": "whitespace-only counts parse as 0"},
    {"input": "4096", "value": 4096},
    {"input": "64K", "value": 64000},
    {"input": "4k", "value": 4000, "note": "suffix is case-insensitive"},
    {"input": "1.5K", "value": 1500},
    {"input": "0.5M", "value": 500000},
    {"input": " 64K ", "value": 64000, "note": "surrounding whitespace is trimmed"},
    {"input": "\u00a05\u3000", "value": 5, "note": "Unicode White_Space is trimmed like ASCII whitespace"},
    {"input": "\u001c5", "error": "invalid token count format", "note": "U+001C is whitespace to Python str.strip but not to Go TrimSpace"},
    {"input": "+5", "value": 5},
    {"input": "-0", "value": 0, "note": "negative zero is not negative"},
    {"input": ".5K", "value": 500},
    {"input": "5.", "value": 5},
    {"input": "1e3", "value": 1000},
    {"input": "1E3K", "value": 1000000},
    {"input": "1e-3K", "value": 1},
    {"input": "1e-400", "value": 0, "note": "decimal underflow rounds to 0 without error"},
    {"input": "1.9999K", "value": 1999, "note": "scaled value truncates toward zero"},
    {"input": "1_000", "value": 1000, "note": "underscores between digits, as in Go literals"},
    {"input": "1_000.5K", "value": 1000500},
    {"input": "1e1_0", "value": 10000000000, "note": "underscores are allowed in the exponent"},
    {"input": "9e18", "value": 9000000000000000000},
    {"input": "0x1p10", "value": 1024, "note": "Go hexadecimal float with mandatory p exponent"},
    {"input": "0X1P10", "value": 1024},
    {"input": "0x1p20K", "value": 1048576000},
    {"input": "0x1.8p3", "value": 12},
    {"input": "0x1p-2K", "value": 250},
    {"input": "0xA_Bp0", "value": 171, "note": "underscores between hex digits"},
    {"input": "0x1p1_0", "value": 1024, "note": "underscores in the hex exponent"},
    {"input": "0x1p-2000", "value": 0, "note": "hex underflow rounds to 0 without error"},
    {"input": "0x1p62", "value": 4611686018427387904},
    {"input": "abc", "error": "invalid token count format"},
    {"input": "１２８", "error": "invalid token count format", "note": "full-width digits are not ASCII"},
    {"input": "٣", "error": "invalid token count format", "note": "Arabic-Indic digit is not ASCII"},
    {"input": "1,000", "error": "invalid token count format"},
    {"input": "5 5", "error": "invalid token count format", "note": "interior whitespace"},
    {"input": "1.2.3", "error": "invalid token count format"},
    {"input": "1e", "error": "invalid token count format"},
    {"input": "1e+", "error": "invalid token count format"},
    {"input": "e5", "error": "invalid token count format"},
    {"input": "1d5", "error": "invalid token count format"},
    {"input": ".", "error": "invalid token count format"},
    {"input": "+", "error": "invalid token count format"},
    {"input": "-", "error": "invalid token count format"},
    {"input": "K", "error": "invalid token count format"},
    {"input": "1KK", "error": "invalid token count format", "note": "only one suffix is stripped"},
    {"input": "1.5G", "error": "invalid token count format", "note": "unknown suffix"},
    {"input": "1__000", "error": "invalid token count format", "note": "consecutive underscores"},
    {"input": "_100", "error": "invalid token count format", "note": "leading underscore"},
    {"input": "100_", "error": "invalid token count format", "note": "trailing underscore"},
    {"input": "1_.5", "error": "invalid token count format", "note": "underscore before the dot"},
    {"input": "1._5", "error": "invalid token count format", "note": "underscore after the dot"},
    {"input": "1_e5", "error": "invalid token count format", "note": "underscore before the exponent"},
    {"input": "1e_5", "error": "invalid token count format", "note": "underscore after the exponent"},
    {"input": "0x", "error": "invalid token count format"},
    {"input": "0x10", "error": "invalid token count format", "note": "hex mantissa requires a p exponent"},
    {"input": "0xp1", "error": "invalid token count format", "note": "hex mantissa requires a digit"},
    {"input": "0x1.8", "error": "invalid token count format"},
    {"input": "0x1e10", "error": "invalid token count format", "note": "e is a hex digit, not an exponent"},
    {"input": "0x_1p0", "value": 1, "note": "the base prefix counts as a digit before an underscore"},
    {"input": "0x1p", "error": "invalid token count format"},
    {"input": "0b101", "error": "invalid token count format"},
    {"input": "0o17", "error": "invalid token count format"},
    {"input": "inf", "error": "invalid token count format"},
    {"input": "-inf", "error": "invalid token count format"},
    {"input": "Infinity", "error": "invalid token count format"},
    {"input": "nan", "error": "invalid token count format"},
    {"input": "1e400", "error": "invalid token count format", "note": "decimal overflow to infinity"},
    {"input": "0x1p99999", "error": "invalid token count format", "note": "hex overflow to infinity"},
    {"input": "-1", "error": "token count must not be negative"},
    {"input": "-0.5K", "error": "token count must not be negative"},
    {"input": "-0x1p10", "error": "token count must not be negative"},
    {"input": "9223372036854775807", "error": "token count is too large", "note": "math.MaxInt rounds up to 2**63 as a float64"},
    {"input": "9223372036854775808K", "error": "token count is too large"},
    {"input": "9.3e18", "error": "token count is too large"},
    {"input": "1e100", "error": "token count is too large"},
    {"input": "1e19M", "error": "token count is too large"},
    {"input": "0x1p63", "error": "token count is too large"}
  ]
}
