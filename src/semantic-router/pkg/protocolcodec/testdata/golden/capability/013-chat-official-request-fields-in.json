{
  "operation": "request",
  "base": {
    "model": "client-model",
    "messages": [{"role": "user", "content": "hello"}]
  },
  "cases": [
    {"name": "audio", "patch": {"audio": {"format": "wav", "voice": "alloy"}}},
    {"name": "frequency_penalty", "patch": {"frequency_penalty": 0.25}},
    {"name": "function_call", "patch": {"function_call": "auto"}},
    {"name": "functions", "patch": {"functions": [{"name": "lookup", "parameters": {"type": "object"}}]}},
    {"name": "logit_bias", "patch": {"logit_bias": {"42": 1}}},
    {"name": "logprobs", "patch": {"logprobs": true}},
    {"name": "max_completion_tokens", "patch": {"max_completion_tokens": 64}},
    {"name": "max_tokens", "patch": {"max_tokens": 64}},
    {"name": "messages", "patch": {"messages": [{"role": "developer", "content": "be concise"}, {"role": "user", "content": "hello"}]}},
    {"name": "metadata", "patch": {"metadata": {"trace": "field-matrix"}}},
    {"name": "modalities", "patch": {"modalities": ["text"]}},
    {"name": "model", "patch": {"model": "alternate-client-model"}},
    {"name": "moderation", "patch": {"moderation": {"mode": "auto"}}},
    {"name": "n", "patch": {"n": 2}},
    {"name": "parallel_tool_calls", "patch": {"parallel_tool_calls": false}},
    {"name": "prediction", "patch": {"prediction": {"type": "content", "content": "expected"}}},
    {"name": "presence_penalty", "patch": {"presence_penalty": 0.5}},
    {"name": "prompt_cache_key", "patch": {"prompt_cache_key": "cache-key"}},
    {"name": "prompt_cache_options", "patch": {"prompt_cache_options": {"retention": "24h"}}},
    {"name": "prompt_cache_retention", "patch": {"prompt_cache_retention": "24h"}},
    {"name": "reasoning_budget_tokens", "patch": {"reasoning_budget_tokens": 1024}},
    {"name": "reasoning_effort", "patch": {"reasoning_effort": "high"}},
    {"name": "response_format", "patch": {"response_format": {"type": "json_object"}}},
    {"name": "safety_identifier", "patch": {"safety_identifier": "safety-user"}},
    {"name": "seed", "patch": {"seed": 7}},
    {"name": "service_tier", "patch": {"service_tier": "default"}},
    {"name": "stop", "patch": {"stop": ["END", "STOP"]}},
    {"name": "store", "patch": {"store": true}},
    {"name": "stream", "patch": {"stream": true}},
    {"name": "stream_options", "patch": {"stream": true, "stream_options": {"include_usage": true, "include_obfuscation": false}}},
    {"name": "temperature", "patch": {"temperature": 0.2}},
    {"name": "tool_choice", "patch": {"tool_choice": "auto"}},
    {"name": "tools", "patch": {"tools": [{"type": "function", "function": {"name": "lookup", "parameters": {"type": "object"}}}]}},
    {"name": "top_logprobs", "patch": {"top_logprobs": 3}},
    {"name": "top_p", "patch": {"top_p": 0.9}},
    {"name": "user", "patch": {"user": "user-1"}},
    {"name": "verbosity", "patch": {"verbosity": "low"}},
    {"name": "web_search_options", "patch": {"web_search_options": {"search_context_size": "low"}}}
  ]
