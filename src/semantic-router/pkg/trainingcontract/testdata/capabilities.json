        "precision/bf16@v1",
        "precision/int8@v1"
      ]
    },
    {
      "id": "hardware/metal@v1",
      "provider": "apple",
      "device_type": "gpu",
      "display_name": "Apple Silicon Metal GPU",
      "supported_precisions": [
        "precision/fp32@v1",
        "precision/fp16@v1"
      ]
    },
    {
      "id": "hardware/rocm@v1",
      "provider": "amd",
      "device_type": "gpu",
      "display_name": "AMD ROCm GPU",
      "supported_precisions": [
        "precision/fp32@v1",
        "precision/fp16@v1",
        "precision/bf16@v1"
      ]
    }
  ]
}
