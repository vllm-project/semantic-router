      "causal-conv1d": "1.7.0 (GPU convolution kernels)",
      "flash-linear-attention": "0.5.2 (GPU gated-delta kernels)",
      "python": "3.12.13",
      "safetensors": "0.8.0",
      "tokenizers": "0.23.2",
      "torch": "2.12.0+git6bbd260 (ROCm 7.2 build; one ROCm GPU tested)",
