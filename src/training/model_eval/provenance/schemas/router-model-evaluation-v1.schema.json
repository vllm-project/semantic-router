{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-project.github.io/semantic-router/schemas/router-model-evaluation-v1.schema.json",
  "title": "Router Model evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "task",
    "artifact_ref",
    "dataset_ref",
    "split_rule",
    "harness",
    "label_mapping",
    "metrics",
    "calibration",
    "abstention",
    "performance"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "kind": {"const": "evaluation"},
    "id": {"$ref": "router-model-common-v1.schema.json#/$defs/manifestId"},
    "task": {"$ref": "router-model-common-v1.schema.json#/$defs/task"},
    "description": {"type": "string", "maxLength": 2000},
    "artifact_ref": {"$ref": "router-model-common-v1.schema.json#/$defs/artifactRef"},
    "dataset_ref": {"$ref": "router-model-common-v1.schema.json#/$defs/datasetRef"},
    "split_rule": {
      "description": "Unit the evaluated split was separated by. by_source holds a whole upstream out, so a translated or near-duplicate row cannot sit on both sides. by_row splits shuffled rows, which lets one leak and inflate the score. predefined uses the split the upstream ships.",
      "type": "string",
      "enum": ["by_source", "by_row", "predefined"]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "device",
        "batch_size",
        "max_length",
        "sample_limit",
        "seed",
        "dependencies"
      ],
      "properties": {
        "code": {"$ref": "router-model-common-v1.schema.json#/$defs/codeRevision"},
        "device": {"type": "string", "enum": ["cpu", "cuda", "rocm", "mps"]},
        "device_name": {"type": "string", "minLength": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "max_length": {"type": "integer", "minimum": 1},
        "sample_limit": {"type": ["integer", "null"], "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "dependencies": {"$ref": "router-model-common-v1.schema.json#/$defs/dependencies"}
      }
    },
    "label_mapping": {"$ref": "router-model-common-v1.schema.json#/$defs/labelMapping"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "accuracy", "macro_f1", "weighted_f1", "per_label"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "accuracy": {"$ref": "#/$defs/unitInterval"},
        "macro_f1": {"$ref": "#/$defs/unitInterval"},
        "weighted_f1": {"$ref": "#/$defs/unitInterval"},
        "per_label": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["precision", "recall", "f1", "support"],
            "properties": {
              "precision": {"$ref": "#/$defs/unitInterval"},
              "recall": {"$ref": "#/$defs/unitInterval"},
              "f1": {"$ref": "#/$defs/unitInterval"},
              "support": {"type": "integer", "minimum": 0}
            }
          }
        },
        "confusion_matrix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin_count", "ece", "mce", "brier", "bins"],
      "properties": {
        "bin_count": {"type": "integer", "minimum": 2, "maximum": 100},
        "ece": {"$ref": "#/$defs/unitInterval"},
        "mce": {"$ref": "#/$defs/unitInterval"},
        "brier": {"type": "number", "minimum": 0, "maximum": 2},
        "bins": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lower", "upper", "count", "confidence", "accuracy"],
            "properties": {
              "lower": {"$ref": "#/$defs/unitInterval"},
              "upper": {"$ref": "#/$defs/unitInterval"},
              "count": {"type": "integer", "minimum": 0},
              "confidence": {"$ref": "#/$defs/unitIntervalOrNull"},
              "accuracy": {"$ref": "#/$defs/unitIntervalOrNull"}
            }
          }
        }
      }
    },
    "abstention": {
      "description": "Coverage/risk as a function of the confidence threshold the router would apply.",
      "type": "object",
      "additionalProperties": false,
      "required": ["curve"],
      "properties": {
        "curve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threshold", "coverage", "selective_accuracy", "abstained"],
            "properties": {
              "threshold": {"$ref": "#/$defs/unitInterval"},
              "coverage": {"$ref": "#/$defs/unitInterval"},
              "selective_accuracy": {"$ref": "#/$defs/unitIntervalOrNull"},
              "abstained": {"type": "integer", "minimum": 0}
            }
          }
        },
        "operating_points": {
          "description": "The decision a gate artifact actually makes: the probability mass on positive_labels compared to the threshold, rather than the argmax confidence the curve above uses. false_positive_rate is the share of safe rows the gate flags, so safe class recall is one minus it. A field is null when the split carries no row on that side.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threshold", "positive_labels", "flagged_rate", "recall", "false_positive_rate", "precision"],
            "properties": {
              "threshold": {"$ref": "#/$defs/unitInterval"},
              "positive_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "flagged_rate": {"$ref": "#/$defs/unitInterval"},
              "recall": {"$ref": "#/$defs/unitIntervalOrNull"},
              "false_positive_rate": {"$ref": "#/$defs/unitIntervalOrNull"},
              "precision": {"$ref": "#/$defs/unitIntervalOrNull"}
            }
          }
        }
      }
    },
    "discrimination": {
      "description": "Separation of the positive class without fixing a threshold, so two artifacts built to different threshold conventions can be compared. recall_at_fpr_budget is the most recall available while flagging no more than fpr_budget of safe rows. Present only for a task that declares positive_labels and a split that carries both sides.",
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_labels", "roc_auc", "fpr_budget", "recall_at_fpr_budget"],
      "properties": {
        "positive_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "roc_auc": {"$ref": "#/$defs/unitInterval"},
        "fpr_budget": {"$ref": "#/$defs/unitInterval"},
        "recall_at_fpr_budget": {"$ref": "#/$defs/unitIntervalOrNull"}
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "rows", "accuracy", "macro_f1"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["language", "length", "robustness", "label"]},
          "rows": {"type": "integer", "minimum": 0},
          "accuracy": {"$ref": "#/$defs/unitIntervalOrNull"},
          "macro_f1": {"$ref": "#/$defs/unitIntervalOrNull"}
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "peak_memory_mb"],
      "properties": {
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mean", "p50", "p95", "p99"],
          "properties": {
            "mean": {"type": "number", "minimum": 0},
            "p50": {"type": "number", "minimum": 0},
            "p95": {"type": "number", "minimum": 0},
            "p99": {"type": "number", "minimum": 0}
          }
        },
        "peak_memory_mb": {"type": "number", "minimum": 0},
        "throughput_rows_per_s": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "unitIntervalOrNull": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
