# Include documentation
include README.md
include QUICKSTART.md
include PUBLISHING.md

# Include templates (now in cli package)
recursive-include cli/templates *.yaml
recursive-include cli/templates *.json
recursive-include cli/templates *.ini
recursive-include cli/model_assets *.yaml *.md *.dsl
include cli/evaluation/golden/metric_analysis_catalog.v1.json
include cli/evaluation/golden/research_benchmark_inventory.v1.json
recursive-include cli/evaluation/resources *.json

# Include requirements
include requirements.txt

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.egg-info
