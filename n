import logging
import os
import sys
import time
from tenacity import retry, stop_after_attempt, wait_exponential
from graphql_client import GraphQLClient

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Set up GraphQL client
graphql_client = GraphQLClient(os.environ['GITHUB_TOKEN'])

@retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=4, max=10))
def fetch_pr_metadata(pr_number):
    try:
        query = '''
            query ($prNumber: Int!) {
                repository(owner: "vllm-project", name: "semantic-router") {
                    pullRequest(number: $prNumber) {
                        labels {
                            nodes {
                                name
                            }
                        }
                        milestone {
                            number
                        }
                        assignees {
                            nodes {
                                login
                            }
                        }
                        reviewDecision
                        mergeStateStatus
                        statusCheckRollup
                    }
                }
            }
        '''
        variables = {'prNumber': pr_number}
        response = graphql_client.execute(query, variables=variables)
        return response['data']['repository']['pullRequest']
    except Exception as e:
        logger.error(f'Failed to fetch PR metadata for {pr_number}: {e}')
        raise

@retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=4, max=10))
def fetch_status_checks(pr_number):
    try:
        query = '''
            query ($prNumber: Int!) {
                repository(owner: "vllm-project", name: "semantic-router") {
                    pullRequest(number: $prNumber) {
                        statusChecks {
                            nodes {
                                context
                                state
                            }
                        }
                    }
                }
            }
        '''
        variables = {'prNumber': pr_number}
        response = graphql_client.execute(query, variables=variables)
        return response['data']['repository']['pullRequest']['statusChecks']['nodes']
    except Exception as e:
        logger.error(f'Failed to fetch status checks for {pr_number}: {e}')
        raise

def generate_maintainer_board(issue_limit, pr_limit):
    issues = []
    prs = []
    for i in range(1, issue_limit + 1):
        try:
            issue = fetch_pr_metadata(i)
            issues.append(issue)
        except Exception as e:
            logger.error(f'Failed to fetch issue {i}: {e}')
    for p in range(1, pr_limit + 1):
        try:
            pr = fetch_pr_metadata(p)
            prs.append(pr)
        except Exception as e:
            logger.error(f'Failed to fetch PR {p}: {e}')
    return issues, prs

def main():
    issue_limit = int(os.environ.get('ISSUE_LIMIT', 10))
    pr_limit = int(os.environ.get('PR_LIMIT', 10))
    issues, prs = generate_maintainer_board(issue_limit, pr_limit)
    logger.info(f'Generated maintainer board with {len(issues)} issues and {len(prs)} PRs')

if __name__ == '__main__':
    main()