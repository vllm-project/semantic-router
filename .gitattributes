# Auto detect text files and perform LF normalization
* text=auto
* text eol=lf

# Binary files - treat as binary, no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary

# Generated wheel resources mirror config/recipes/built-in and are byte-checked by CI.
# Keep them in source distributions, but collapse their duplicate GitHub diff.

# Prebuilt CK Flash Attention shared library (ROCm/gfx942)
onnx-binding/ort-ck-flash-attn/prebuilt/libort_ck_flash_attn.so* binary
*.a binary
