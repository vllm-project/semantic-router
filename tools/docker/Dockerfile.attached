# Standalone Router with external model-runtime endpoints.
# The standard path builds amd64/arm64; native builders can supply ROUTER_BUILD
# as a qualified image carrying /out/router, without changing this stage graph.
ARG IMAGE_REGISTRY=docker.io/
ARG GO_IMAGE=library/golang:1.25-bookworm
ARG ASSETS_IMAGE=library/python:3.12-slim-bookworm
ARG ATTACHED_BASE_IMAGE=library/debian:trixie-slim
ARG ROUTER_BUILD=router-build

FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}${GO_IMAGE} AS router-build
ARG TARGETARCH
RUN if [ "$TARGETARCH" = amd64 ] && [ "$(dpkg --print-architecture)" = arm64 ]; then \
      echo "Use a native amd64 builder for an amd64 attached image; ARM64-to-amd64 cross-builds are not supported." >&2; \
      exit 1; \
    fi && \
    if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross && \
      rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /src/semantic-router
ARG GOPROXY="https://proxy.golang.org|direct"
ENV GOPROXY=${GOPROXY}
COPY src/semantic-router/go.mod src/semantic-router/go.sum ./
RUN go mod download
COPY src/semantic-router/ ./
RUN if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      export CC=aarch64-linux-gnu-gcc; \
    fi && \
    CGO_ENABLED=1 GOOS=linux GOARCH="$TARGETARCH" \
      go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/router ./cmd

FROM ${ROUTER_BUILD} AS router-artifact

FROM scratch AS router-binary
COPY --from=router-artifact /out/router /out/router

FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}${ASSETS_IMAGE} AS image-routing-assets
RUN if ! command -v python3 >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends python3 && \
      rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /source
COPY tools/calibration/image-routing/prepare_assets.py tools/calibration/image-routing/prepare_assets.py
COPY config/assets/image-routing/manifest.json config/assets/image-routing/manifest.json
COPY website/static/img/ website/static/img/
COPY dashboard/frontend/public/ dashboard/frontend/public/
RUN python3 tools/calibration/image-routing/prepare_assets.py --repository-root /source --output /out

FROM scratch AS router-files
COPY --from=image-routing-assets /out/ /app/share/image-routing/
COPY config/knowledge_bases/ /app/config/knowledge_bases/
COPY config/config.yaml /app/config/config.yaml
COPY src/vllm-sr/cli/ /app/cli/
COPY src/semantic-router/pkg/configschema/router-config-v0.3.schema.json /app/cli/config_schema/router-config-v0.3.schema.json
COPY config/recipes/built-in/ /app/cli/model_assets/
COPY config/fragments/algorithm/selection/latency-aware.yaml /app/cli/proposal_assets/fragments/algorithm/selection/latency-aware.yaml
COPY --chmod=0755 src/vllm-sr/start-router.sh /app/start-router.sh
COPY --from=router-artifact /out/router /usr/local/bin/router

FROM ${IMAGE_REGISTRY}${ATTACHED_BASE_IMAGE} AS vllm-sr-attached
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl python3 python3-yaml libgcc-s1 && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app/config /app/models && \
    useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin vllm-sr
WORKDIR /app
ENV USER=vllm-sr
COPY --from=router-files / /
EXPOSE 8801 50051 8080 9190
VOLUME ["/app/models"]
ENTRYPOINT ["/app/start-router.sh"]
