# Router images: the Go router with the built-in model runtime.
#
# One stage graph builds every published router image: vllm-sr, vllm-sr-rocm
# and vllm-sr-cuda. The router binary and the image-routing assets are shared
# by all of them; only the runtime's PyTorch build differs per accelerator.
# The same image serves `vllm-sr serve`, the Helm chart and the Operator.
#
#   docker build -f tools/docker/Dockerfile.extproc -t vllm-sr .
#   docker build -f tools/docker/Dockerfile.extproc --build-arg ACCELERATOR=rocm -t vllm-sr-rocm .
#   docker build -f tools/docker/Dockerfile.extproc --build-arg ACCELERATOR=cuda -t vllm-sr-cuda .
#
# ACCELERATOR is cpu (linux/amd64 and linux/arm64), rocm or cuda (linux/amd64).
# The CUDA image takes PyTorch from the official wheel, which carries its CUDA
# user-space libraries. The ROCm image takes PyTorch and the ROCm user space
# from vLLM's ROCm image (ROCM_TORCH_IMAGE, pinned by digest) and builds
# causal-conv1d for CAUSAL_CONV1D_ARCHS (default gfx90a, gfx942 and gfx950:
# Instinct MI200, MI300 and MI350). The host supplies only the GPU driver.
ARG IMAGE_REGISTRY=docker.io/
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
ARG ROCM_TORCH_IMAGE=vllm/vllm-openai-rocm@sha256:1fd21abe66455b4df5a2e83629e97cdcc9d58913b16052d8118b92b239792339
ARG ACCELERATOR=cpu

# The router is a Go binary. cgo links only valkey-glide's bundled static
# library, so the build needs the target's C linker and nothing else.
FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}library/golang:1.25-bookworm AS router-build
ARG TARGETARCH
RUN if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross && \
      rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /src/semantic-router
# Pipe falls back to direct on any proxy error; comma only on 404 and 410.
ENV GOPROXY="https://proxy.golang.org|direct"
COPY src/semantic-router/go.mod src/semantic-router/go.sum ./
RUN go mod download
COPY src/semantic-router/ ./
RUN if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      export CC=aarch64-linux-gnu-gcc; \
    fi && \
    CGO_ENABLED=1 GOOS=linux GOARCH="$TARGETARCH" \
      go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/router ./cmd

# Frozen image-routing prototypes; no model download or inference.
FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}${PYTHON_IMAGE} AS image-routing-assets
WORKDIR /source
COPY tools/calibration/image-routing/prepare_assets.py tools/calibration/image-routing/prepare_assets.py
COPY config/assets/image-routing/manifest.json config/assets/image-routing/manifest.json
COPY website/static/img/ website/static/img/
COPY dashboard/frontend/public/ dashboard/frontend/public/
RUN python tools/calibration/image-routing/prepare_assets.py --repository-root /source --output /out

FROM ${IMAGE_REGISTRY}${PYTHON_IMAGE} AS python-base
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# PyTorch per accelerator, in its own layer: the largest and least often
# changed part of every image. GPU images add FLA's Triton kernels (fla-core,
# the version the runtime's pinned kernel choices were recorded with), which
# import packaging without declaring it. Triton compiles each kernel's launcher
# with the C compiler and Python's headers when the kernel first runs, so GPU
# images carry gcc and libc6-dev, and the build checks both are usable.
FROM python-base AS torch-cpu
ARG TORCH_CPU=torch==2.10.0
RUN pip install --index-url https://download.pytorch.org/whl/cpu "$TORCH_CPU" && \
    python -c "import torch"

# ROCm takes the rocm7.2 wheels: the rocm7.1 build crashes replaying the
# runtime's HIP graphs.
FROM python-base AS torch-rocm-base
ARG TARGETARCH
ARG TORCH_ROCM=torch==2.12.0
ARG TORCH_ROCM_INDEX=https://download.pytorch.org/whl/rocm7.2
RUN test "$TARGETARCH" = amd64 || { echo "ACCELERATOR=rocm supports linux/amd64 only" >&2; exit 1; }
# The ROCm wheels link libatomic, which the slim base does not carry.
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --index-url "$TORCH_ROCM_INDEX" "$TORCH_ROCM" && \
    pip install fla-core==0.5.2 packaging && \
    python -c "import torch, fla.ops.gated_delta_rule" && \
    printf '#include <Python.h>\n' | cc -fsyntax-only -x c -I "$(python -c 'import sysconfig; print(sysconfig.get_paths()["include"])')" -

# causal-conv1d publishes no ROCm wheel, so it is built against the official
# PyTorch wheel with the ROCm SDK and build tools the released decoders' wheel
# was built with: the same compiler emits the same GPU code, which keeps the
# decoders' convolution identical to their released answers. Without it they
# fall back to a reference convolution that misses them. A GPU the wheel has no
# code for fails at the decoders' first convolution instead, so
# CAUSAL_CONV1D_ARCHS names every GPU the image serves. Only the wheel leaves
# this stage. AMD's packages are pinned over Debian's older ROCm of the same
# names, and ROCm's lld needs libxml2, which they don't declare.
FROM torch-rocm-base AS causal-conv1d-rocm
ARG ROCM_SDK=7.2.3
ARG CAUSAL_CONV1D=causal-conv1d==1.7.0
ARG CAUSAL_CONV1D_ARCHS=gfx90a,gfx942,gfx950
RUN mkdir -p /etc/apt/keyrings && \
    python -c "import urllib.request; urllib.request.urlretrieve('https://repo.radeon.com/rocm/rocm.gpg.key', '/etc/apt/keyrings/rocm.asc')" && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.asc] https://repo.radeon.com/rocm/apt/$ROCM_SDK jammy main" \
      > /etc/apt/sources.list.d/rocm.list && \
    printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' > /etc/apt/preferences.d/rocm && \
    apt-get update && \
    apt-get install -y --no-install-recommends g++ libxml2 hipcc hip-dev rocm-llvm rocm-device-libs hipcub-dev rocprim-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install setuptools==79.0.1 wheel==0.48.0 ninja==1.13.2 && \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE HIP_ARCHITECTURES="$CAUSAL_CONV1D_ARCHS" ROCM_PATH=/opt/rocm \
      pip wheel --no-build-isolation --no-deps --no-binary causal-conv1d --wheel-dir /wheels "$CAUSAL_CONV1D"

# The ROCm image serves with the PyTorch of vLLM's ROCm image, not the official
# wheel: its AOTriton (0.13.50) and ROCm 7.2.3 libraries give the released
# decoders' attention and convolution answers bit for bit, which the official
# wheel's bundled AOTriton 0.11.2 misses. The official wheel above still
# installs PyTorch's Python dependencies and Triton, and builds causal-conv1d.
# Torch needs GCC 16's C++ runtime, which Debian doesn't ship, so it comes from
# the same image and replaces Debian's older one (both are backward compatible).
FROM ${IMAGE_REGISTRY}${ROCM_TORCH_IMAGE} AS rocm-torch-release

# Only the ROCm files the serving stack can load leave the release image, each
# unchanged. Left behind: static and Fortran libraries, ROCm's LLVM (Triton
# links with its own ld.lld; comgr carries its compiler), rocFFT's kernel
# cache (rocFFT compiles what it misses), rocALUTION and hipTensor (nothing
# links them), and the GEMM kernels and MIOpen databases of GPUs outside
# ROCM_GPU_ARCHS, which must name every GPU in CAUSAL_CONV1D_ARCHS.
FROM rocm-torch-release AS rocm-lib-slim
ARG ROCM_GPU_ARCHS=gfx90a,gfx942,gfx950
RUN cd /opt/rocm-7.2.3 && \
    find lib -name '*.a' -delete && \
    rm -rf lib/llvm lib/rocfft/rocfft_kernel_cache.db lib/librocalution* lib/libhiptensor* && \
    find lib/rocblas/library lib/hipblaslt/library lib/hipsparselt/library share/miopen/db -type f -name '*gfx*' | \
      awk -F/ -v keep="$(echo "$ROCM_GPU_ARCHS" | tr , '|')" '$NF !~ keep' | xargs -r rm -f && \
    find lib -xtype l -delete

FROM python-base AS torch-rocm
ARG TARGETARCH
ARG TORCH_ROCM=torch==2.12.0
ARG TORCH_ROCM_INDEX=https://download.pytorch.org/whl/rocm7.2
ARG ROCM_TORCH_DIST=torch-2.12.0+git6bbd260.dist-info
ARG RELEASE_SITE=/usr/local/lib/python3.12/dist-packages
ARG SITE=/usr/local/lib/python3.12/site-packages
RUN test "$TARGETARCH" = amd64 || { echo "ACCELERATOR=rocm supports linux/amd64 only" >&2; exit 1; }
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 gcc libc6-dev \
      libdrm2 libdrm-amdgpu1 libdw1 libelf1 libnuma1 libopenmpi3 libhwloc15 \
      libevent-core-2.1-7 libevent-pthreads-2.1-7 libudev1 libexpat1 libgomp1 && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --index-url "$TORCH_ROCM_INDEX" "$TORCH_ROCM" && \
    pip install fla-core==0.5.2 packaging && \
    pip uninstall -y torch
COPY --link --from=rocm-lib-slim /opt/rocm-7.2.3/lib /opt/rocm-7.2.3/lib
COPY --link --from=rocm-lib-slim /opt/rocm-7.2.3/share/miopen /opt/rocm-7.2.3/share/miopen
COPY --link --from=rocm-torch-release /opt/rocm-7.2.3/.info /opt/rocm-7.2.3/.info
# GCC 16's C++ runtime replaces Debian's; the packages are held so that no later
# apt-get restores Debian's files under PyTorch.
COPY --from=rocm-torch-release /lib/x86_64-linux-gnu/libstdc++.so.6.0.35 \
    /lib/x86_64-linux-gnu/libgcc_s.so.1 /lib/x86_64-linux-gnu/libgomp.so.1.0.0 /usr/lib/x86_64-linux-gnu/
COPY --from=rocm-torch-release ${RELEASE_SITE}/torch ${SITE}/torch
COPY --from=rocm-torch-release ${RELEASE_SITE}/${ROCM_TORCH_DIST} ${SITE}/${ROCM_TORCH_DIST}
COPY --from=rocm-torch-release ${RELEASE_SITE}/torchgen ${SITE}/torchgen
COPY --from=rocm-torch-release ${RELEASE_SITE}/functorch ${SITE}/functorch
ENV ROCM_PATH=/opt/rocm
RUN --mount=type=bind,from=causal-conv1d-rocm,source=/wheels,target=/tmp/wheels \
    ln -s /opt/rocm-7.2.3 /opt/rocm && \
    ln -sf libstdc++.so.6.0.35 /usr/lib/x86_64-linux-gnu/libstdc++.so.6 && \
    apt-mark hold libstdc++6 libgcc-s1 libgomp1 >/dev/null && \
    echo /opt/rocm/lib > /etc/ld.so.conf.d/rocm.conf && ldconfig && \
    for lib in "$SITE"/torch/lib/*.so /opt/rocm/lib/libMIOpen.so /opt/rocm/lib/libamdhip64.so; do \
      ! ldd "$lib" | grep "not found" || exit 1; \
    done && \
    pip install --no-deps /tmp/wheels/causal_conv1d-*.whl && \
    python -c "import torch, causal_conv1d, fla.ops.gated_delta_rule; assert torch.version.git_version.startswith('6bbd260')" && \
    printf '#include <Python.h>\n' | cc -fsyntax-only -x c -I "$(python -c 'import sysconfig; print(sysconfig.get_paths()["include"])')" -

FROM python-base AS torch-cuda
ARG TARGETARCH
ARG TORCH_CUDA=torch==2.10.0
ARG TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu128
RUN test "$TARGETARCH" = amd64 || { echo "ACCELERATOR=cuda supports linux/amd64 only" >&2; exit 1; }
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --index-url "$TORCH_CUDA_INDEX" "$TORCH_CUDA" && \
    pip install fla-core==0.5.2 packaging && \
    python -c "import torch, fla.ops.gated_delta_rule" && \
    printf '#include <Python.h>\n' | cc -fsyntax-only -x c -I "$(python -c 'import sysconfig; print(sysconfig.get_paths()["include"])')" -

# The model runtime: its third-party dependencies in one layer and the package
# in the next, so a runtime code change does not reinstall its dependencies.
# The multimodal extra decodes Vela Omni's images (Pillow). Every default model
# runs on the native engine, so ONNX Runtime (the onnx extra) is not installed.
FROM torch-${ACCELERATOR} AS runtime
ARG MODEL_RUNTIME_EXTRAS=multimodal
RUN --mount=type=bind,source=src/model-runtime/pyproject.toml,target=/tmp/pyproject.toml \
    python - $MODEL_RUNTIME_EXTRAS >/tmp/runtime-requirements.txt <<'EOF' && \
    pip install -r /tmp/runtime-requirements.txt && \
    rm /tmp/runtime-requirements.txt
import sys, tomllib
project = tomllib.load(open("/tmp/pyproject.toml", "rb"))["project"]
extras = project.get("optional-dependencies", {})
print("\n".join(project["dependencies"] + [dep for name in sys.argv[1:] for dep in extras[name]]))
EOF
RUN --mount=type=bind,source=src/model-runtime,target=/tmp/model-runtime,rw \
    pip install --no-deps /tmp/model-runtime

# The router image. Immutable assets sit outside the mounted model cache, each
# in an independent layer.
FROM runtime AS vllm-sr
WORKDIR /app
# The charts run the router as uid 65532; other uids (OpenShift) have no passwd
# entry, so Python's getpass and PyTorch's compile caches take USER.
RUN mkdir -p /app/config /app/models && \
    useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin vllm-sr
ENV USER=vllm-sr
# Models the managed runtime downloads persist in the model volume, and so do
# Triton's compiled kernels and MIOpen's databases and lock files (a ROCm
# convolution fails without them): the charts' root filesystem is read-only and
# the router's uid has no home directory.
ENV VLLM_SRUN_CACHE_DIR=/app/models/model-runtime \
    TRITON_CACHE_DIR=/app/models/triton \
    MIOPEN_USER_DB_PATH=/app/models/miopen \
    MIOPEN_CUSTOM_CACHE_DIR=/app/models/miopen
# The CLI's readiness and status probes run curl inside the container.
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    python -c "import torch"
COPY --link --from=image-routing-assets /out/ /app/share/image-routing/
COPY config/knowledge_bases/ /app/config/knowledge_bases/
COPY config/config.yaml /app/config/config.yaml
COPY src/vllm-sr/cli/ /app/cli/
COPY src/semantic-router/pkg/configschema/router-config-v0.3.schema.json /app/cli/config_schema/router-config-v0.3.schema.json
COPY config/recipes/built-in/ /app/cli/model_assets/
COPY --chmod=0755 src/vllm-sr/start-router.sh /app/start-router.sh
COPY --link --from=router-build /out/router /usr/local/bin/router
EXPOSE 50051 8080 9190
VOLUME ["/app/models"]
# With no arguments or with router flags, the entrypoint runs the Router on
# /app/config/config.yaml (Kubernetes); with a config path, the CLI stack.
ENTRYPOINT ["/app/start-router.sh"]
