FROM golang:1.25

# System dependencies — matches CI "Install system dependencies" step.
# shellcheck is the native apt binary (CI does NOT use shellcheck-py).
RUN apt-get update && apt-get install -y \
    make \
    build-essential \
    pkg-config \
    shellcheck \
    jq \
    python3 \
    python3-pip \
    python3-venv \
    python3-setuptools \
    python3-wheel \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 — matches CI setup-node and website dependency requirements
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# markdownlint-cli pinned — matches the harness bootstrap version
RUN npm install -g markdownlint-cli@0.43.0

# Keep pip-managed tools separate from Debian packages and their metadata.
# The repository harness can still create its own .venv-agent environment.
RUN python3 -m venv /opt/precommit-venv
ENV PATH="/opt/precommit-venv/bin:${PATH}"

# Python tooling — versions match tools/agent/requirements.txt so that
# `make check` and `make precommit-check` both work out of the box.
RUN python -m pip install \
    PyYAML==6.0.3 \
    codespell==2.4.1 \
    pre-commit==4.3.0 \
    ruff==0.15.5 \
    tree-sitter==0.25.2 \
    tree-sitter-go==0.25.0 \
    tree-sitter-javascript==0.25.0 \
    tree-sitter-python==0.25.0 \
    tree-sitter-rust==0.24.0 \
    tree-sitter-typescript==0.23.2 \
    yamllint==1.38.0 \
    && python -m pip check \
    && python -c 'from pathlib import Path; import sys, packaging, pre_commit; root = Path(sys.prefix); assert root == Path("/opt/precommit-venv") and sys.prefix != sys.base_prefix; assert all(Path(module.__file__).resolve().is_relative_to(root) for module in (packaging, pre_commit))'

# golangci-lint version is pinned once in tools/linter/go/golangci-lint.version and shared with CI and Makefiles
COPY tools/linter/go/golangci-lint.version /tmp/golangci-version
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b $(go env GOPATH)/bin "v$(cat /tmp/golangci-version)" \
    && rm /tmp/golangci-version

# Helm matches the CI Test And Build toolchain and is required by make check.
ARG HELM_VERSION=v3.14.0
RUN helm_arch="$(dpkg --print-architecture)" && \
    helm_archive="helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz" && \
    helm_tmp="$(mktemp -d)" && cd "${helm_tmp}" && \
    curl -fsSLO "https://get.helm.sh/${helm_archive}" && \
    curl -fsSLO "https://get.helm.sh/${helm_archive}.sha256sum" && \
    sha256sum -c "${helm_archive}.sha256sum" && \
    tar -xzf "${helm_archive}" && \
    install -m 0755 "linux-${helm_arch}/helm" /usr/local/bin/helm && \
    cd / && rm -rf "${helm_tmp}" && helm version --short
