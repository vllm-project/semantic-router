{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-project.github.io/semantic-router/schemas/recipe-metadata-v1.schema.json",
  "title": "vLLM Semantic Router managed recipe metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "authors",
    "license",
    "tags",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": "vllm-sr/recipe-metadata/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "links": {
      "$ref": "#/$defs/links"
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "$ref": "#/$defs/cleanHttpsUri"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "homepage": {
          "$ref": "#/$defs/cleanHttpsUri"
        },
        "source": {
          "$ref": "#/$defs/cleanHttpsUri"
        },
        "documentation": {
          "$ref": "#/$defs/cleanHttpsUri"
        }
      }
    },
    "cleanHttpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
    }
  }
}
