# hx-vllm-srun-cpu.service environment — CPU mode on HX-2.
# Same model cache and offline posture as the qualified GPU configuration;
# GPU allocator variables are deliberately absent (no CUDA_VISIBLE_DEVICES,
# no HX_SRUN_CUDA_MEMORY_FRACTION, no HX_SRUN_PLACEMENT_RESERVE_MIB).
HX_SRUN_HOST=0.0.0.0
HF_HOME=/srv/hx-semantic-router/models/hf
HF_HUB_CACHE=/srv/hx-semantic-router/models/hf/hub
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
XDG_CACHE_HOME=/srv/hx-semantic-router/cache/xdg
TRITON_CACHE_DIR=/srv/hx-semantic-router/cache/triton
TORCHINDUCTOR_CACHE_DIR=/srv/hx-semantic-router/cache/torchinductor
TMPDIR=/srv/hx-semantic-router/tmp
