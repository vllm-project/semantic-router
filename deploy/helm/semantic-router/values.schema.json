{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "semantic-router Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of Semantic Router pod replicas when autoscaling is disabled."
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "standalone",
            "extproc"
          ],
          "description": "standalone: the Router serves config.listeners itself; extproc: the Router serves ext_proc gRPC for a gateway in front of it."
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "description": "Standalone only: a kubernetes.io/tls Secret mounted at /app/config/certs for listener TLS."
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "safetyGuards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rejectMultiReplicaLocalLearningState": {
          "type": "boolean",
          "description": "Reject multi-replica router renders when active config enables Router Learning request-time local state."
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "alerts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render PrometheusRule alerts for Semantic Router metrics."
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "requestErrorRate": {
                  "type": "number",
                  "minimum": 0
                },
                "completionLatencyP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "firstResponseObservationP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "responseDurationPerOutputTokenP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "routingLatencyP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "inflightRequests": {
                  "type": "number",
                  "minimum": 0
                },
                "cacheHitRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "algorithm": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "storage_path": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "configOverride": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "minProperties": 1,
      "description": "Complete canonical Router config that atomically replaces chart config defaults before Kubernetes integration rewrites."
    },
    "decisionModel": {
      "type": "string",
      "pattern": "^((?i)vela-2\\.0-(0\\.3b|0\\.8b|4b|9b)|(?i)vela-1\\.0)?$",
      "description": "The Router's decision model (global.model_catalog.system.decision_model): Vela-2.0-0.3B, Vela-2.0-0.8B, Vela-2.0-4B, Vela-2.0-9B or Vela-1.0; empty leaves the config's own."
    },
    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applyValuesRevision": {
          "type": "string",
          "description": "Change this revision to apply chart config values once on upgrade; the same revision preserves later runtime edits."
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowOpenBootstrap": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "mountPath": {
              "type": "string"
            }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fsGroup": {
              "type": "integer"
            }
          }
        },
        "jwtSecret": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        }
      }
    }
  }
}
