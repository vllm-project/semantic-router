{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "semantic-router Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of Semantic Router pod replicas when autoscaling is disabled."
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Overrides the capability-derived default; null enables this resource when a Management store is configured."
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSkew",
        "topologyKey",
        "whenUnsatisfiable"
      ],
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Overrides the capability-derived default; null enables this resource when a Management store is configured."
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress"
      ],
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Overrides the capability-derived default; null enables this resource when a Management store is configured."
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extProcPeers",
            "managementPeers",
            "backendDispatchPeers",
            "metricsPeers"
          ],
          "properties": {
            "extProcPeers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "managementPeers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "backendDispatchPeers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricsPeers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "safetyGuards": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rejectMultiReplicaLocalLearningState": {
          "type": "boolean",
          "description": "Reject multi-replica router renders when active config enables Router Learning request-time local state."
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "alerts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render PrometheusRule alerts for Semantic Router metrics."
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "thresholds": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "requestErrorRate": {
                  "type": "number",
                  "minimum": 0
                },
                "completionLatencyP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "ttftP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "tpotP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "routingLatencyP95Seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "inflightRequests": {
                  "type": "number",
                  "minimum": 0
                },
                "cacheHitRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "configOverride": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "minProperties": 1,
      "description": "Complete canonical Router config that atomically replaces chart config defaults before Kubernetes integration rewrites."
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "providers",
        "routing",
        "recipes",
        "entrypoints"
      ],
      "properties": {
        "version": {
          "const": "v0.3"
        },
        "providers": {
          "type": "object"
        },
        "routing": {
          "type": "object"
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowOpenBootstrap": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "mountPath": {
              "type": "string"
            }
          }
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fsGroup": {
              "type": "integer"
            }
          }
        },
        "jwtSecret": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        },
        "routerTLS": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ca"
          ],
          "properties": {
            "ca": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "existingSecret",
                "existingSecretKey"
              ],
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        }
      }
    }
  }
}
